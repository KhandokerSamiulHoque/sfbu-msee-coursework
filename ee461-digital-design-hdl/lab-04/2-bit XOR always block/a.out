#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0xd23cb0 .scope module, "tb" "tb" 2 1;
 .timescale 0 0;
v0xd342e0_0 .var "x", 0 0;
v0xd343b0_0 .var "y", 0 0;
v0xd34460_0 .net "z", 0 0, v0xd34240_0; 1 drivers
S_0xd23da0 .scope module, "XOR_always_block" "xor_gate" 2 5, 3 1, S_0xd23cb0;
 .timescale 0 0;
v0xd017f0_0 .net "x", 0 0, v0xd342e0_0; 1 drivers
v0xd341a0_0 .net "y", 0 0, v0xd343b0_0; 1 drivers
v0xd34240_0 .var "z", 0 0;
E_0xd00230 .event edge, v0xd017f0_0, v0xd341a0_0;
    .scope S_0xd23da0;
T_0 ;
    %wait E_0xd00230;
    %load/v 8, v0xd017f0_0, 1;
    %load/v 9, v0xd341a0_0, 1;
    %xor 8, 9, 1;
    %set/v v0xd34240_0, 8, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0xd23cb0;
T_1 ;
    %vpi_call 2 8 "$dumpfile", "dump.vcd";
    %vpi_call 2 9 "$dumpvars";
    %set/v v0xd342e0_0, 0, 1;
    %set/v v0xd343b0_0, 0, 1;
    %delay 5, 0;
    %set/v v0xd342e0_0, 0, 1;
    %set/v v0xd343b0_0, 1, 1;
    %delay 5, 0;
    %set/v v0xd342e0_0, 1, 1;
    %set/v v0xd343b0_0, 0, 1;
    %delay 5, 0;
    %set/v v0xd342e0_0, 1, 1;
    %set/v v0xd343b0_0, 1, 1;
    %vpi_call 2 23 "$display", "x=%b y=%b, z=%b", v0xd342e0_0, v0xd343b0_0, v0xd34460_0;
    %delay 5, 0;
    %vpi_call 2 24 "$finish";
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.sv";
    "design.sv";
