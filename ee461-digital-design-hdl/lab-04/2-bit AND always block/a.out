#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0xe3dcb0 .scope module, "tb" "tb" 2 1;
 .timescale 0 0;
v0xe4e380_0 .var "x", 0 0;
v0xe4e450_0 .var "y", 0 0;
v0xe4e500_0 .net "z", 0 0, v0xe4e2e0_0; 1 drivers
S_0xe3dda0 .scope module, "AND_always_block" "and_gate" 2 6, 3 1, S_0xe3dcb0;
 .timescale 0 0;
v0xe1b890_0 .net "x", 0 0, v0xe4e380_0; 1 drivers
v0xe4e240_0 .net "y", 0 0, v0xe4e450_0; 1 drivers
v0xe4e2e0_0 .var "z", 0 0;
E_0xe1aff0 .event edge, v0xe1b890_0, v0xe4e240_0;
    .scope S_0xe3dda0;
T_0 ;
    %wait E_0xe1aff0;
    %load/v 8, v0xe1b890_0, 1;
    %load/v 9, v0xe4e240_0, 1;
    %and 8, 9, 1;
    %set/v v0xe4e2e0_0, 8, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0xe3dcb0;
T_1 ;
    %vpi_call 2 10 "$dumpfile", "dump.vcd";
    %vpi_call 2 11 "$dumpvars";
    %set/v v0xe4e380_0, 0, 1;
    %set/v v0xe4e450_0, 0, 1;
    %delay 1, 0;
    %set/v v0xe4e380_0, 1, 1;
    %set/v v0xe4e450_0, 0, 1;
    %delay 1, 0;
    %set/v v0xe4e380_0, 1, 1;
    %set/v v0xe4e450_0, 0, 1;
    %delay 1, 0;
    %set/v v0xe4e380_0, 1, 1;
    %set/v v0xe4e450_0, 1, 1;
    %vpi_call 2 25 "$display", "x = %b y = %b z= %b", v0xe4e380_0, v0xe4e450_0, v0xe4e500_0;
    %delay 1, 0;
    %vpi_call 2 26 "$finish";
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.sv";
    "design.sv";
