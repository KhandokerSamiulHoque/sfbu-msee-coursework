#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x1b4bcb0 .scope module, "tb" "tb" 2 1;
 .timescale 0 0;
v0x1b5c340_0 .var "x", 0 0;
v0x1b5c410_0 .var "y", 0 0;
v0x1b5c4c0_0 .net "z", 0 0, v0x1b5c2a0_0; 1 drivers
S_0x1b4bda0 .scope module, "NAND_always_block" "nand_gate" 2 5, 3 1, S_0x1b4bcb0;
 .timescale 0 0;
v0x1b29850_0 .net "x", 0 0, v0x1b5c340_0; 1 drivers
v0x1b5c200_0 .net "y", 0 0, v0x1b5c410_0; 1 drivers
v0x1b5c2a0_0 .var "z", 0 0;
E_0x1b28fb0 .event edge, v0x1b29850_0, v0x1b5c200_0;
    .scope S_0x1b4bda0;
T_0 ;
    %wait E_0x1b28fb0;
    %load/v 8, v0x1b29850_0, 1;
    %load/v 9, v0x1b5c200_0, 1;
    %nand 8, 9, 1;
    %set/v v0x1b5c2a0_0, 8, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x1b4bcb0;
T_1 ;
    %vpi_call 2 8 "$dumpfile", "tb.vcd";
    %vpi_call 2 9 "$dumpvars";
    %set/v v0x1b5c340_0, 0, 1;
    %set/v v0x1b5c410_0, 0, 1;
    %delay 5, 0;
    %set/v v0x1b5c340_0, 0, 1;
    %set/v v0x1b5c410_0, 1, 1;
    %delay 5, 0;
    %set/v v0x1b5c340_0, 1, 1;
    %set/v v0x1b5c410_0, 0, 1;
    %delay 5, 0;
    %set/v v0x1b5c340_0, 1, 1;
    %set/v v0x1b5c410_0, 1, 1;
    %vpi_call 2 21 "$display", "x = %b y = %b c= %b", v0x1b5c340_0, v0x1b5c410_0, v0x1b5c4c0_0;
    %delay 5, 0;
    %vpi_call 2 23 "$finish";
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.sv";
    "design.sv";
