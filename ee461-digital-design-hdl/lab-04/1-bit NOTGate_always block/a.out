#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x27caa50 .scope module, "tb" "tb" 2 1;
 .timescale 0 0;
v0x27d9940_0 .var "x", 0 0;
v0x27d9a10_0 .net "y", 0 0, v0x27d98a0_0; 1 drivers
S_0x27cab40 .scope module, "NOTGate_always_block" "not_gate" 2 7, 3 1, S_0x27caa50;
 .timescale 0 0;
v0x27a6dd0_0 .net "x", 0 0, v0x27d9940_0; 1 drivers
v0x27d98a0_0 .var "y", 0 0;
E_0x27ca320 .event edge, v0x27a6dd0_0;
    .scope S_0x27cab40;
T_0 ;
    %wait E_0x27ca320;
    %load/v 8, v0x27a6dd0_0, 1;
    %inv 8, 1;
    %set/v v0x27d98a0_0, 8, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x27caa50;
T_1 ;
    %vpi_call 2 10 "$dumpfile", "dump.vcd";
    %vpi_call 2 11 "$dumpvars";
    %set/v v0x27d9940_0, 0, 1;
    %delay 5, 0;
    %set/v v0x27d9940_0, 1, 1;
    %delay 5, 0;
    %vpi_call 2 15 "$display", "x = %b, y = %b", v0x27d9940_0, v0x27d9a10_0;
    %vpi_call 2 16 "$finish";
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.sv";
    "design.sv";
