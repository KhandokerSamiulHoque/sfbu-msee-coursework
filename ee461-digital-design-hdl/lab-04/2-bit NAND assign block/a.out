#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x22d9a30 .scope module, "tb" "tb" 2 1;
 .timescale 0 0;
v0x22e9f20_0 .var "x", 0 0;
v0x22e9ff0_0 .var "y", 0 0;
v0x22ea0a0_0 .net "z", 0 0, L_0x22ea150; 1 drivers
S_0x22d9b20 .scope module, "NAND_assign_block" "nand_gate" 2 5, 3 1, S_0x22d9a30;
 .timescale 0 0;
L_0x22ea150 .functor NAND 1, v0x22e9f20_0, v0x22e9ff0_0, C4<1>, C4<1>;
v0x22d9c10_0 .net "x", 0 0, v0x22e9f20_0; 1 drivers
v0x22e9de0_0 .net "y", 0 0, v0x22e9ff0_0; 1 drivers
v0x22e9e80_0 .alias "z", 0 0, v0x22ea0a0_0;
    .scope S_0x22d9a30;
T_0 ;
    %vpi_call 2 8 "$dumpfile", "dump.vcd";
    %vpi_call 2 9 "$dumpvars";
    %set/v v0x22e9f20_0, 0, 1;
    %set/v v0x22e9ff0_0, 0, 1;
    %delay 5, 0;
    %set/v v0x22e9f20_0, 0, 1;
    %set/v v0x22e9ff0_0, 1, 1;
    %delay 5, 0;
    %set/v v0x22e9f20_0, 1, 1;
    %set/v v0x22e9ff0_0, 0, 1;
    %delay 5, 0;
    %set/v v0x22e9f20_0, 1, 1;
    %set/v v0x22e9ff0_0, 1, 1;
    %vpi_call 2 21 "$display", "x = %b y = %b z = %b", v0x22e9f20_0, v0x22e9ff0_0, v0x22ea0a0_0;
    %delay 5, 0;
    %vpi_call 2 22 "$finish";
    %end;
    .thread T_0;
