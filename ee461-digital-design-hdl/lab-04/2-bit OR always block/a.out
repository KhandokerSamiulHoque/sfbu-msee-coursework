#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x1ef5cb0 .scope module, "tb" "tb" 2 1;
 .timescale 0 0;
v0x1f05cf0_0 .var "x", 0 0;
v0x1f05dc0_0 .var "y", 0 0;
v0x1f05e70_0 .net "z", 0 0, v0x1f05c50_0; 1 drivers
S_0x1ef5da0 .scope module, "OR_always_block" "OR_gate" 2 6, 3 1, S_0x1ef5cb0;
 .timescale 0 0;
v0x1ed2120_0 .net "x", 0 0, v0x1f05cf0_0; 1 drivers
v0x1f05bb0_0 .net "y", 0 0, v0x1f05dc0_0; 1 drivers
v0x1f05c50_0 .var "z", 0 0;
E_0x1ed2290 .event edge, v0x1ed2120_0, v0x1f05bb0_0;
    .scope S_0x1ef5da0;
T_0 ;
    %wait E_0x1ed2290;
    %load/v 8, v0x1ed2120_0, 1;
    %load/v 9, v0x1f05bb0_0, 1;
    %or 8, 9, 1;
    %set/v v0x1f05c50_0, 8, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x1ef5cb0;
T_1 ;
    %vpi_call 2 9 "$dumpfile", "dump.vcd";
    %vpi_call 2 10 "$dumpvars";
    %set/v v0x1f05cf0_0, 0, 1;
    %set/v v0x1f05dc0_0, 0, 1;
    %delay 5, 0;
    %set/v v0x1f05cf0_0, 0, 1;
    %set/v v0x1f05dc0_0, 1, 1;
    %delay 5, 0;
    %set/v v0x1f05cf0_0, 1, 1;
    %set/v v0x1f05dc0_0, 0, 1;
    %delay 5, 0;
    %set/v v0x1f05cf0_0, 1, 1;
    %set/v v0x1f05dc0_0, 1, 1;
    %delay 10, 0;
    %vpi_call 2 24 "$finish";
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.sv";
    "design.sv";
