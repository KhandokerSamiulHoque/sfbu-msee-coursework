#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x146ca30 .scope module, "tb" "tb" 2 1;
 .timescale 0 0;
v0x147ce60_0 .var "x", 0 0;
v0x147cf30_0 .var "y", 0 0;
v0x147cfe0_0 .net "z", 0 0, L_0x147d090; 1 drivers
S_0x146cb20 .scope module, "XOR_assign_block" "xor_gate" 2 5, 3 1, S_0x146ca30;
 .timescale 0 0;
L_0x147d090 .functor XOR 1, v0x147ce60_0, v0x147cf30_0, C4<0>, C4<0>;
v0x146cc10_0 .net "x", 0 0, v0x147ce60_0; 1 drivers
v0x147cd20_0 .net "y", 0 0, v0x147cf30_0; 1 drivers
v0x147cdc0_0 .alias "z", 0 0, v0x147cfe0_0;
    .scope S_0x146ca30;
T_0 ;
    %vpi_call 2 8 "$dumpfile", "dump.vcd";
    %vpi_call 2 9 "$dumpvars";
    %set/v v0x147ce60_0, 0, 1;
    %set/v v0x147cf30_0, 0, 1;
    %delay 5, 0;
    %set/v v0x147ce60_0, 0, 1;
    %set/v v0x147cf30_0, 1, 1;
    %delay 5, 0;
    %set/v v0x147ce60_0, 1, 1;
    %set/v v0x147cf30_0, 0, 1;
    %delay 5, 0;
    %set/v v0x147ce60_0, 1, 1;
    %set/v v0x147cf30_0, 1, 1;
    %vpi_call 2 23 "$display", "x=%b y=%b, z=%b", v0x147ce60_0, v0x147cf30_0, v0x147cfe0_0;
    %delay 5, 0;
    %vpi_call 2 25 "$finish";
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.sv";
    "design.sv";
