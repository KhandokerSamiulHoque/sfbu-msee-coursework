#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0xed8cb0 .scope module, "tb" "tb" 2 1;
 .timescale 0 0;
v0xee92e0_0 .var "x", 0 0;
v0xee93b0_0 .var "y", 0 0;
v0xee9460_0 .net "z", 0 0, v0xee9240_0; 1 drivers
S_0xed8da0 .scope module, "XNOR_always_block" "xnor_gate" 2 5, 3 1, S_0xed8cb0;
 .timescale 0 0;
v0xeb67f0_0 .net "x", 0 0, v0xee92e0_0; 1 drivers
v0xee91a0_0 .net "y", 0 0, v0xee93b0_0; 1 drivers
v0xee9240_0 .var "z", 0 0;
E_0xeb5230 .event edge, v0xeb67f0_0, v0xee91a0_0;
    .scope S_0xed8da0;
T_0 ;
    %wait E_0xeb5230;
    %load/v 8, v0xeb67f0_0, 1;
    %load/v 9, v0xee91a0_0, 1;
    %xnor 8, 9, 1;
    %set/v v0xee9240_0, 8, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0xed8cb0;
T_1 ;
    %vpi_call 2 8 "$dumpfile", "dump.vcd";
    %vpi_call 2 9 "$dumpvars";
    %set/v v0xee92e0_0, 0, 1;
    %set/v v0xee93b0_0, 0, 1;
    %delay 5, 0;
    %set/v v0xee92e0_0, 0, 1;
    %set/v v0xee93b0_0, 1, 1;
    %delay 5, 0;
    %set/v v0xee92e0_0, 1, 1;
    %set/v v0xee93b0_0, 0, 1;
    %delay 5, 0;
    %set/v v0xee92e0_0, 1, 1;
    %set/v v0xee93b0_0, 1, 1;
    %vpi_call 2 23 "$display", "x=%b y=%b, z=%b", v0xee92e0_0, v0xee93b0_0, v0xee9460_0;
    %delay 5, 0;
    %vpi_call 2 24 "$finish";
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.sv";
    "design.sv";
