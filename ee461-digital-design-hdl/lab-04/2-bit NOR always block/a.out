#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x1c6acb0 .scope module, "tb" "tb" 2 1;
 .timescale 0 0;
v0x1c7c160_0 .var "x", 0 0;
v0x1c7c230_0 .var "y", 0 0;
v0x1c7c2e0_0 .net "z", 0 0, v0x1c7c0c0_0; 1 drivers
E_0x1c472b0 .event posedge, v0x1c7c0c0_0;
S_0x1c6ada0 .scope module, "NOR_always_block" "nor_gate" 2 5, 3 1, S_0x1c6acb0;
 .timescale 0 0;
v0x1c49020_0 .net "x", 0 0, v0x1c7c160_0; 1 drivers
v0x1c7c020_0 .net "y", 0 0, v0x1c7c230_0; 1 drivers
v0x1c7c0c0_0 .var "z", 0 0;
E_0x1c48720 .event edge, v0x1c49020_0, v0x1c7c020_0;
    .scope S_0x1c6ada0;
T_0 ;
    %wait E_0x1c48720;
    %load/v 8, v0x1c49020_0, 1;
    %load/v 9, v0x1c7c020_0, 1;
    %nor 8, 9, 1;
    %set/v v0x1c7c0c0_0, 8, 1;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x1c6acb0;
T_1 ;
    %vpi_call 2 8 "$dumpfile", "dump.vcd";
    %vpi_call 2 9 "$dumpvars";
    %set/v v0x1c7c160_0, 0, 1;
    %set/v v0x1c7c230_0, 0, 1;
    %delay 5, 0;
    %set/v v0x1c7c160_0, 0, 1;
    %set/v v0x1c7c230_0, 1, 1;
    %delay 5, 0;
    %set/v v0x1c7c160_0, 1, 1;
    %set/v v0x1c7c230_0, 0, 1;
    %delay 5, 0;
    %set/v v0x1c7c160_0, 1, 1;
    %set/v v0x1c7c230_0, 1, 1;
    %vpi_call 2 23 "$display", "x=%b y=%b z=%b", v0x1c7c160_0, v0x1c7c230_0, v0x1c7c2e0_0;
    %delay 5, 0;
    %vpi_call 2 24 "$finish";
    %end;
    .thread T_1;
    .scope S_0x1c6acb0;
T_2 ;
    %wait E_0x1c472b0;
    %vpi_call 2 28 "$monitor", "At time= %0t, x=%b, y=%b, z=%b", $time, v0x1c7c160_0, v0x1c7c230_0, v0x1c7c2e0_0;
    %jmp T_2;
    .thread T_2;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.sv";
    "design.sv";
