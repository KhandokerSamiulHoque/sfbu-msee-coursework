#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x8cba30 .scope module, "tb" "tb" 2 1;
 .timescale 0 0;
v0x8dbf00_0 .var "x", 0 0;
v0x8dbfd0_0 .var "y", 0 0;
v0x8dc080_0 .net "z", 0 0, L_0x8dc130; 1 drivers
S_0x8cbb20 .scope module, "AND_assign_block" "bitwise_and" 2 6, 3 1, S_0x8cba30;
 .timescale 0 0;
L_0x8dc130 .functor AND 1, v0x8dbf00_0, v0x8dbfd0_0, C4<1>, C4<1>;
v0x8cbc10_0 .net "x", 0 0, v0x8dbf00_0; 1 drivers
v0x8dbdc0_0 .net "y", 0 0, v0x8dbfd0_0; 1 drivers
v0x8dbe60_0 .alias "z", 0 0, v0x8dc080_0;
    .scope S_0x8cba30;
T_0 ;
    %vpi_call 2 8 "$dumpfile", "dump.vcd";
    %vpi_call 2 9 "$dumpvars";
    %set/v v0x8dbf00_0, 0, 1;
    %set/v v0x8dbfd0_0, 0, 1;
    %delay 1, 0;
    %set/v v0x8dbf00_0, 1, 1;
    %set/v v0x8dbfd0_0, 0, 1;
    %delay 1, 0;
    %set/v v0x8dbf00_0, 1, 1;
    %set/v v0x8dbfd0_0, 0, 1;
    %delay 1, 0;
    %set/v v0x8dbf00_0, 1, 1;
    %set/v v0x8dbfd0_0, 1, 1;
    %vpi_call 2 23 "$display", "x = %b y = %b z= %b", v0x8dbf00_0, v0x8dbfd0_0, v0x8dc080_0;
    %delay 1, 0;
    %vpi_call 2 24 "$finish";
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "testbench.sv";
    "design.sv";
