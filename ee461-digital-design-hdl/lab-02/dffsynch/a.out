#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x1cd00c0 .scope module, "dff_synch" "dff_synch" 2 3;
 .timescale 0 0;
v0x1ce0480_0 .var "clk_i", 0 0;
v0x1ce0550_0 .var "d_i", 0 0;
v0x1ce0600_0 .net "q_o", 0 0, v0x1ce0330_0; 1 drivers
v0x1ce06b0_0 .var "rst_i", 0 0;
S_0x1cd01b0 .scope module, "dff_synch" "dffsynch" 2 7, 3 2, S_0x1cd00c0;
 .timescale 0 0;
v0x1cad850_0 .net "clk_i", 0 0, v0x1ce06b0_0; 1 drivers
v0x1ce0290_0 .net "d_i", 0 0, v0x1ce0550_0; 1 drivers
v0x1ce0330_0 .var "q_o", 0 0;
v0x1ce03d0_0 .net "rst_i", 0 0, v0x1ce0480_0; 1 drivers
E_0x1ccf500 .event posedge, v0x1cad850_0;
    .scope S_0x1cd01b0;
T_0 ;
    %wait E_0x1ccf500;
    %load/v 8, v0x1ce03d0_0, 1;
    %jmp/0xz  T_0.0, 8;
    %ix/load 0, 1, 0;
    %assign/v0 v0x1ce0330_0, 0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/v 8, v0x1ce0290_0, 1;
    %ix/load 0, 1, 0;
    %assign/v0 v0x1ce0330_0, 0, 8;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x1cd00c0;
T_1 ;
    %set/v v0x1ce0550_0, 0, 1;
    %set/v v0x1ce0480_0, 0, 1;
    %set/v v0x1ce06b0_0, 0, 1;
    %vpi_call 2 14 "$dumpfile", "test.vcd";
    %vpi_call 2 15 "$dumpvars", 2'sb01;
    %delay 100, 0;
    %vpi_call 2 16 "$finish";
    %end;
    .thread T_1;
    .scope S_0x1cd00c0;
T_2 ;
    %delay 2, 0;
    %load/v 8, v0x1ce0550_0, 1;
    %inv 8, 1;
    %set/v v0x1ce0550_0, 8, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x1cd00c0;
T_3 ;
    %delay 4, 0;
    %load/v 8, v0x1ce0480_0, 1;
    %inv 8, 1;
    %set/v v0x1ce0480_0, 8, 1;
    %jmp T_3;
    .thread T_3;
    .scope S_0x1cd00c0;
T_4 ;
    %delay 6, 0;
    %load/v 8, v0x1ce06b0_0, 1;
    %inv 8, 1;
    %set/v v0x1ce06b0_0, 8, 1;
    %jmp T_4;
    .thread T_4;
