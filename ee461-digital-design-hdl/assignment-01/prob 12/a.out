#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x2135920 .scope module, "helloWorld" "helloWorld" 2 1;
 .timescale 0 0;
    .scope S_0x2135920;
T_0 ;
    %vpi_call 2 3 "$display", "ASCII code for \042 (double quote) character: %d", 7'sb0100010;
    %vpi_call 2 4 "$display", "ASCII code for %% (percentage) character: %d", 7'sb0100101;
    %vpi_call 2 5 "$display", "ASCII code for @ (at) character: %d", 8'sb01000000;
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "design.sv";
