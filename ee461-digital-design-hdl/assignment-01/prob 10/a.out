#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0xb35560 .scope module, "comparison_Real_Display" "comparison_Real_Display" 2 1;
 .timescale 0 0;
v0xb35650_0 .var "display_time", 63 0;
v0xb665e0_0 .var "real_time", 63 0;
    .scope S_0xb35560;
T_0 ;
    %vpi_func/r 2 4 "$realtime", 4;
    %cvt/vr 8, 4, 64;
    %set/v v0xb665e0_0, 8, 64;
    %delay 3, 0;
    %vpi_func 2 5 "$time", 8, 64;
    %set/v v0xb35650_0, 8, 64;
    %vpi_call 2 6 "$display", "Real time: %t", v0xb665e0_0;
    %vpi_call 2 7 "$display", "Display time: %t", v0xb35650_0;
    %vpi_call 2 8 "$finish";
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "design.sv";
