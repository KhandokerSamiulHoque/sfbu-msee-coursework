#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x22b5570 .scope module, "triduladevicevariablee" "triduladevicevariablee" 2 1;
 .timescale 0 0;
L_0x22e7690 .functor BUFZ 1, C4<z>, C4<0>, C4<0>, C4<0>;
v0x22b58f0_0 .net "device2", 0 0, C4<z>; 0 drivers
RS_0x7f7b6a136048 .resolv tri, C4<1>, L_0x22e7690, C4<z>, C4<z>;
v0x22e7580_0 .net8 "tri_var", 0 0, RS_0x7f7b6a136048; 2 drivers
    .scope S_0x22b5570;
T_0 ;
    %vpi_call 2 7 "$monitor", "At time %0t, tri_variable = %b", $time, v0x22e7580_0;
    %delay 10, 0;
    %vpi_call 2 9 "$finish";
    %end;
    .thread T_0;
