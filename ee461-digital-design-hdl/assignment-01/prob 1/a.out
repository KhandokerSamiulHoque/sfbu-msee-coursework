#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x13fced0 .scope module, "helloWorld" "helloWorld" 2 2;
 .timescale 0 0;
    .scope S_0x13fced0;
T_0 ;
    %vpi_call 2 4 "$display", "Hellor Worldf !!!";
    %delay 10, 0;
    %vpi_call 2 5 "$finish";
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "design.sv";
