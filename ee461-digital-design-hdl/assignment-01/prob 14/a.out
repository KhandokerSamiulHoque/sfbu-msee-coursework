#! /usr/share/iverilog-0.9.7/bin/vvp
:ivl_version "0.9.7 " "(v0_9_6)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_0x27a3830 .scope module, "compare" "compare" 2 1;
 .timescale 0 0;
v0x27a3950_0 .var "m", 7 0;
v0x27d4ed0_0 .var "n", 3 0;
E_0x27a3920 .event edge, v0x27d4ed0_0, v0x27a3950_0;
    .scope S_0x27a3830;
T_0 ;
    %movi 8, 240, 8;
    %set/v v0x27a3950_0, 8, 8;
    %end;
    .thread T_0;
    .scope S_0x27a3830;
T_1 ;
    %movi 8, 3, 4;
    %set/v v0x27d4ed0_0, 8, 4;
    %end;
    .thread T_1;
    .scope S_0x27a3830;
T_2 ;
    %vpi_call 2 6 "$display", "$display system task: m = %h, n = %d", v0x27a3950_0, v0x27d4ed0_0;
    %vpi_call 2 7 "$write", "$write system task: m = %h, n = %d", v0x27a3950_0, v0x27d4ed0_0;
    %vpi_call 2 8 "$monitor", "$monitor system task: m = %h, n = %d", v0x27a3950_0, v0x27d4ed0_0;
    %end;
    .thread T_2;
    .scope S_0x27a3830;
T_3 ;
    %wait E_0x27a3920;
    %vpi_call 2 12 "$display", "m = %h and n = %d", v0x27a3950_0, v0x27d4ed0_0;
    %jmp T_3;
    .thread T_3, $push;
